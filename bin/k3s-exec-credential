#!/usr/bin/env bash
set -euo pipefail
umask 077

log() {
    printf 'k3s-exec-credential: %s\n' "$*" >&2
}

die() {
    log "$*"
    exit 1
}

# ------------------------------------------------------------
# 設定
# ------------------------------------------------------------

MODE="${K3S_CREDENTIAL_MODE:-ssh}"
SSH_PORT="${K3S_SSH_PORT:-22}"
SSH_KEY="${K3S_SSH_KEY:-}"

case "$MODE" in
    ssh)
        : "${K3S_SSH_HOST:?sshモードではK3S_SSH_HOSTを指定してください}"
        : "${K3S_SSH_USER:?sshモードではK3S_SSH_USERを指定してください}"

        cache_host="$K3S_SSH_HOST"
        prompt_target="${K3S_SSH_USER}@${K3S_SSH_HOST}"

        [[ "$K3S_SSH_HOST" != -* ]] \
            || die "SSHホスト名の先頭にハイフンは使用できません"

        [[ "$SSH_PORT" =~ ^[0-9]+$ ]] \
            || die "SSHポートには数値を指定してください"
        ;;

    local)
        # K3S_SSH_HOSTを指定した場合はキャッシュ名として利用。
        cache_host="${K3S_SSH_HOST:-$(uname -n)}"
        prompt_target="local:${cache_host}"
        ;;

    *)
        die "K3S_CREDENTIAL_MODEにはsshまたはlocalを指定してください"
        ;;
esac

[[ "$cache_host" != */* ]] \
    || die "キャッシュ名に使用するホスト名にスラッシュは使用できません"

CACHE="${K3S_CREDENTIAL_CACHE:-${HOME}/.kube/credentials/${cache_host}.yaml}"

for cmd in \
    kubectl openssl jq date flock mktemp cmp \
    dirname mkdir chmod mv cat rm
do
    command -v "$cmd" >/dev/null \
        || die "必要なコマンドがありません: $cmd"
done

if [[ "$MODE" == ssh ]]; then
    command -v ssh >/dev/null \
        || die "必要なコマンドがありません: ssh"
else
    command -v sudo >/dev/null \
        || die "必要なコマンドがありません: sudo"
fi

[[ "$CACHE" == /* ]] \
    || die "キャッシュには絶対パスを指定してください"

# ------------------------------------------------------------
# キャッシュディレクトリ・ロック・一時領域
# ------------------------------------------------------------

# 資格情報のキャッシュ専用ディレクトリを指定すること。
cache_dir="$(dirname "$CACHE")"
mkdir -p -- "$cache_dir"
chmod 700 "$cache_dir"

lock="${CACHE}.lock"

[[ ! -L "$lock" ]] \
    || die "ロックファイルがシンボリックリンクです"

exec 9>"$lock"
chmod 600 "$lock"
flock -x 9

# 同時実行を考慮し、ロック取得後に確認する。
[[ ! -L "$CACHE" ]] \
    || die "キャッシュにシンボリックリンクは指定できません"

if [[ -e "$CACHE" && ! -f "$CACHE" ]]; then
    die "キャッシュのパスが通常ファイルではありません"
fi

work="$(mktemp -d "$cache_dir/.k3s-exec.XXXXXX")"

cleanup() {
    unset sudo_password
    rm -rf -- "$work"
}

trap cleanup EXIT

# ------------------------------------------------------------
# 資格情報の抽出・検証
# ------------------------------------------------------------

extract_credentials() {
    local config="$1"

    # ローカルの設定を読み取るだけで、APIには接続しない。
    kubectl --kubeconfig="$config" config view \
        --minify --raw -o json > "$work/config.json"

    jq -er '
        .users[0].user["client-certificate-data"]
        | strings
        | select(length > 0)
    ' "$work/config.json" \
        | openssl base64 -d -A > "$work/client.crt"

    jq -er '
        .users[0].user["client-key-data"]
        | strings
        | select(length > 0)
    ' "$work/config.json" \
        | openssl base64 -d -A > "$work/client.key"

    openssl x509 \
        -in "$work/client.crt" \
        -noout >/dev/null

    # 暗号化された秘密鍵の対話プロンプトは出さない。
    openssl pkey \
        -in "$work/client.key" \
        -passin pass: \
        -noout >/dev/null

    openssl x509 \
        -in "$work/client.crt" \
        -pubkey -noout > "$work/cert.pub"

    openssl pkey \
        -in "$work/client.key" \
        -passin pass: \
        -pubout > "$work/key.pub"

    cmp -s "$work/cert.pub" "$work/key.pub" \
        || die "証明書と秘密鍵が一致しません"
}

# ------------------------------------------------------------
# 取得が必要か判定
# ------------------------------------------------------------

need_fetch=false
old_subject=""

if [[ ! -e "$CACHE" ]]; then
    need_fetch=true
    log "キャッシュがないため、初回取得します"
else
    chmod 600 "$CACHE"

    # 破損・秘密鍵不一致の場合は自動取得せず停止する。
    extract_credentials "$CACHE"

    if ! openssl x509 \
        -in "$work/client.crt" \
        -checkend 0 -noout >/dev/null; then

        need_fetch=true

        old_subject="$(
            openssl x509 \
                -in "$work/client.crt" \
                -noout -subject -nameopt RFC2253
        )"

        log "証明書が期限切れのため、再取得します"
    fi
fi

# ------------------------------------------------------------
# 対話認証して資格情報を取得
# ------------------------------------------------------------

if [[ "$need_fetch" == true ]]; then
    exec_info="${KUBERNETES_EXEC_INFO:-}"

    if [[ -n "$exec_info" ]]; then
        interactive="$(
            printf '%s' "$exec_info" \
                | jq -r '.spec.interactive // false'
        )"

        [[ "$interactive" == true ]] \
            || die "取得には対話入力が必要です。端末からkubectlを実行してください"
    fi

    [[ -t 0 ]] \
        || die "標準入力が端末ではありません。対話端末から実行してください"

    # これ以降、パスワードをシェルトレースに出さない。
    set +x
    sudo_password=""

    printf '[%s] sudoパスワード: ' "$prompt_target" >&2

    if ! IFS= read -r -s sudo_password; then
        printf '\n' >&2
        die "パスワードを読み取れませんでした"
    fi

    printf '\n' >&2
    fetch_ok=false

    case "$MODE" in
        ssh)
            ssh_opts=(
                -T
                -o BatchMode=yes
                -o StrictHostKeyChecking=yes
                -o ConnectTimeout=10
                -o ServerAliveInterval=10
                -o ServerAliveCountMax=2
                -p "$SSH_PORT"
                -l "$K3S_SSH_USER"
            )

            if [[ -n "$SSH_KEY" ]]; then
                ssh_opts+=(
                    -i "$SSH_KEY"
                    -o IdentitiesOnly=yes
                )
            fi

            if printf '%s\n' "$sudo_password" \
                | ssh "${ssh_opts[@]}" "$K3S_SSH_HOST" \
                    "sudo -S -k -p '' -- cat /etc/rancher/k3s/k3s.yaml" \
                    > "$work/source.yaml"; then

                fetch_ok=true
            fi
            ;;

        local)
            if printf '%s\n' "$sudo_password" \
                | sudo -S -k -p '' -- \
                    cat /etc/rancher/k3s/k3s.yaml \
                    > "$work/source.yaml"; then

                fetch_ok=true
            fi
            ;;
    esac

    unset sudo_password

    [[ "$fetch_ok" == true ]] \
        || die "取得に失敗しました。sudoパスワード・sudo権限・接続設定を確認してください"

    extract_credentials "$work/source.yaml"

    openssl x509 \
        -in "$work/client.crt" \
        -checkend 0 -noout >/dev/null \
        || die "取得元の証明書も期限切れです。キャッシュは更新しません"

    new_subject="$(
        openssl x509 \
            -in "$work/client.crt" \
            -noout -subject -nameopt RFC2253
    )"

    if [[ -n "$old_subject" && "$old_subject" != "$new_subject" ]]; then
        die "証明書のSubjectが異なります。キャッシュは更新しません"
    fi
fi

# ------------------------------------------------------------
# 有効期間確認・ExecCredential生成
# ------------------------------------------------------------

not_before="$(
    openssl x509 -in "$work/client.crt" -noout -startdate
)"
not_before_epoch="$(date -u -d "${not_before#notBefore=}" +%s)"
now_epoch="$(date -u +%s)"

if (( now_epoch < not_before_epoch )); then
    die "証明書の有効期間開始前です。端末・サーバーの時刻を確認してください"
fi

not_after="$(
    openssl x509 -in "$work/client.crt" -noout -enddate
)"
expiration="$(
    date -u -d "${not_after#notAfter=}" '+%Y-%m-%dT%H:%M:%SZ'
)"

jq -n \
    --arg expiration "$expiration" \
    --rawfile cert "$work/client.crt" \
    --rawfile key "$work/client.key" \
    '{
        apiVersion: "client.authentication.k8s.io/v1",
        kind: "ExecCredential",
        status: {
            expirationTimestamp: $expiration,
            clientCertificateData: $cert,
            clientKeyData: $key
        }
    }' > "$work/credential.json"

# ------------------------------------------------------------
# キャッシュ保存・資格情報返却
# ------------------------------------------------------------

if [[ "$need_fetch" == true ]]; then
    # 同一ファイルシステム内で置き換える。
    chmod 600 "$work/source.yaml"
    mv -f -- "$work/source.yaml" "$CACHE"
    log "キャッシュを保存しました"
fi

# 標準出力にはExecCredentialのJSONだけを返す。
cat "$work/credential.json"
