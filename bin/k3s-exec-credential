#!/usr/bin/env bash
set -euo pipefail
umask 077

log() {
    printf 'k3s-exec-credential: %s\n' "$*" >&2
}

die() {
    log "$*"
    exit 1
}

# 必須の接続設定。
: "${K3S_SSH_HOST:?K3S_SSH_HOSTを指定してください}"
: "${K3S_SSH_USER:?K3S_SSH_USERを指定してください}"

SSH_PORT="${K3S_SSH_PORT:-22}"
SSH_KEY="${K3S_SSH_KEY:-}"

# 明示指定がなければ、SSHホスト名ごとのキャッシュを使用。
CACHE="${K3S_CREDENTIAL_CACHE:-${HOME}/.kube/credentials/${K3S_SSH_HOST}.yaml}"

for cmd in \
    kubectl openssl jq date ssh flock mktemp cmp \
    dirname mkdir chmod mv cat rm
do
    command -v "$cmd" >/dev/null \
        || die "必要なコマンドがありません: $cmd"
done

[[ "$CACHE" == /* ]] \
    || die "キャッシュには絶対パスを指定してください"

# ホスト名はデフォルトのキャッシュファイル名にも使う。
[[ "$K3S_SSH_HOST" != */* && "$K3S_SSH_HOST" != -* ]] \
    || die "SSHホスト名にスラッシュや先頭のハイフンは使用できません"

[[ "$SSH_PORT" =~ ^[0-9]+$ ]] \
    || die "SSHポートには数値を指定してください"

# このディレクトリは資格情報キャッシュ専用にする。
cache_dir="$(dirname "$CACHE")"
mkdir -p -- "$cache_dir"
chmod 700 "$cache_dir"

# 同じキャッシュへの並行アクセスを直列化。
lock="${CACHE}.lock"
[[ ! -L "$lock" ]] \
    || die "ロックファイルがシンボリックリンクです"

exec 9>"$lock"
chmod 600 "$lock"
flock -x 9

# 存在確認はロック取得後に行う。
[[ ! -L "$CACHE" ]] \
    || die "キャッシュにシンボリックリンクは指定できません"

if [[ -e "$CACHE" && ! -f "$CACHE" ]]; then
    die "キャッシュのパスが通常ファイルではありません"
fi

work="$(mktemp -d "$cache_dir/.k3s-exec.XXXXXX")"

cleanup() {
    unset sudo_password
    rm -rf -- "$work"
}
trap cleanup EXIT

# kubeconfigから埋め込み証明書・秘密鍵を抽出する。
# config viewのみを使い、Kubernetes APIへは接続しない。
extract_credentials() {
    local config="$1"

    kubectl --kubeconfig="$config" config view \
        --minify --raw -o json > "$work/config.json"

    jq -er '
        .users[0].user["client-certificate-data"]
        | strings
        | select(length > 0)
    ' "$work/config.json" \
        | openssl base64 -d -A > "$work/client.crt"

    jq -er '
        .users[0].user["client-key-data"]
        | strings
        | select(length > 0)
    ' "$work/config.json" \
        | openssl base64 -d -A > "$work/client.key"

    openssl x509 \
        -in "$work/client.crt" \
        -noout >/dev/null

    openssl pkey \
        -in "$work/client.key" \
        -passin pass: \
        -noout >/dev/null

    # 証明書と秘密鍵の対応を確認。
    openssl x509 \
        -in "$work/client.crt" \
        -pubkey -noout > "$work/cert.pub"

    openssl pkey \
        -in "$work/client.key" \
        -passin pass: \
        -pubout > "$work/key.pub"

    cmp -s "$work/cert.pub" "$work/key.pub" \
        || die "証明書と秘密鍵が一致しません"
}

need_fetch=false
old_subject=""

if [[ ! -e "$CACHE" ]]; then
    need_fetch=true
    log "キャッシュがないため、初回取得します"
else
    chmod 600 "$CACHE"

    # 破損や秘密鍵不一致の場合は、取得せずエラー終了。
    extract_credentials "$CACHE"

    if ! openssl x509 \
        -in "$work/client.crt" \
        -checkend 0 -noout >/dev/null; then

        need_fetch=true

        old_subject="$(
            openssl x509 \
                -in "$work/client.crt" \
                -noout -subject -nameopt RFC2253
        )"

        log "証明書が期限切れのため、再取得します"
    fi
fi

if [[ "$need_fetch" == true ]]; then
    # execプラグインに標準入力が渡されているか確認。
    exec_info="${KUBERNETES_EXEC_INFO:-}"

    if [[ -n "$exec_info" ]]; then
        interactive="$(
            printf '%s' "$exec_info" \
                | jq -r '.spec.interactive // false'
        )"

        [[ "$interactive" == true ]] \
            || die "資格情報の取得には対話入力が必要です。端末からkubectlを実行してください"
    fi

    # 直接起動時も含め、端末以外からパスワードを読まない。
    [[ -t 0 ]] \
        || die "標準入力が端末ではありません。対話端末から実行してください"

    ssh_opts=(
        -T
        -o BatchMode=yes
        -o StrictHostKeyChecking=yes
        -o ConnectTimeout=10
        -o ServerAliveInterval=10
        -o ServerAliveCountMax=2
        -p "$SSH_PORT"
        -l "$K3S_SSH_USER"
    )

    if [[ -n "$SSH_KEY" ]]; then
        ssh_opts+=(
            -i "$SSH_KEY"
            -o IdentitiesOnly=yes
        )
    fi

    # これ以降、パスワードをシェルトレースに出さない。
    set +x
    sudo_password=""

    printf '[%s@%s] sudoパスワード: ' \
        "$K3S_SSH_USER" "$K3S_SSH_HOST" >&2

    if ! IFS= read -r -s sudo_password; then
        printf '\n' >&2
        die "パスワードを読み取れませんでした"
    fi

    printf '\n' >&2

    # パスワードは標準入力で渡す。
    # stdoutはkubeconfig、stderrはsudo/SSHのエラーに分離。
    if printf '%s\n' "$sudo_password" \
        | ssh "${ssh_opts[@]}" "$K3S_SSH_HOST" \
            "sudo -S -k -p '' -- cat /etc/rancher/k3s/k3s.yaml" \
            > "$work/remote.yaml"; then

        unset sudo_password
    else
        unset sudo_password
        die "取得に失敗しました。sudoパスワード・SSH接続・sudo権限を確認してください"
    fi

    extract_credentials "$work/remote.yaml"

    openssl x509 \
        -in "$work/client.crt" \
        -checkend 0 -noout >/dev/null \
        || die "サーバー側の証明書も期限切れです。キャッシュは更新しません"

    new_subject="$(
        openssl x509 \
            -in "$work/client.crt" \
            -noout -subject -nameopt RFC2253
    )"

    if [[ -n "$old_subject" && "$old_subject" != "$new_subject" ]]; then
        die "証明書のSubjectが異なります。キャッシュは更新しません"
    fi
fi

# 有効期間開始前の証明書も拒否する。
not_before="$(
    openssl x509 -in "$work/client.crt" -noout -startdate
)"
not_before_epoch="$(date -u -d "${not_before#notBefore=}" +%s)"
now_epoch="$(date -u +%s)"

if (( now_epoch < not_before_epoch )); then
    die "証明書の有効期間開始前です。端末・サーバーの時刻を確認してください"
fi

not_after="$(
    openssl x509 -in "$work/client.crt" -noout -enddate
)"
expiration="$(
    date -u -d "${not_after#notAfter=}" '+%Y-%m-%dT%H:%M:%SZ'
)"

# キャッシュ更新前に返却JSONを生成。
jq -n \
    --arg expiration "$expiration" \
    --rawfile cert "$work/client.crt" \
    --rawfile key "$work/client.key" \
    '{
        apiVersion: "client.authentication.k8s.io/v1",
        kind: "ExecCredential",
        status: {
            expirationTimestamp: $expiration,
            clientCertificateData: $cert,
            clientKeyData: $key
        }
    }' > "$work/credential.json"

if [[ "$need_fetch" == true ]]; then
    # 同じファイルシステム内のrenameで置き換える。
    chmod 600 "$work/remote.yaml"
    mv -f -- "$work/remote.yaml" "$CACHE"
    log "キャッシュを保存しました"
fi

# 標準出力にはExecCredentialのJSONだけを出す。
cat "$work/credential.json"
